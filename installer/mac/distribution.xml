<?xml version="1.0" encoding="utf-8"?>
<!-- Alien for Grasshopper: the macOS installer package, built by tools/package.sh (productbuild).
     Installs for the current user only: Alien.gha into Grasshopper's Libraries folder under ~/Library.
     __VERSION__ and __PKGVERSION__ are filled in by package.sh. -->
<installer-gui-script minSpecVersion="2">
    <title>Alien __VERSION__</title>
    <organization>com.alien</organization>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="pkg-background.png" alignment="bottomleft" scaling="none" mime-type="image/png"/>
    <background-darkAqua file="pkg-background-dark.png" alignment="bottomleft" scaling="none" mime-type="image/png"/>
    <installation-check script="rhinoClosed()"/>
    <script><![CDATA[
// Grasshopper keeps Alien.gha loaded while Rhino runs, so Rhino must be closed to replace it.
function rhinoClosed() {
    if (system.applications.fromIdentifier('com.mcneel.rhinoceros.8')) {
        my.result.title = 'Quit Rhino first';
        my.result.message = 'Rhino 8 is open. Quit it (Rhino 8 > Quit Rhinoceros, or Cmd+Q), then open this installer again.';
        my.result.type = 'Fatal';
        return false;
    }
    return true;
}
    ]]></script>
    <choices-outline>
        <line choice="alien"/>
    </choices-outline>
    <choice id="alien" title="Alien for Grasshopper">
        <pkg-ref id="com.alien.grasshopper"/>
    </choice>
    <pkg-ref id="com.alien.grasshopper" version="__PKGVERSION__" onConclusion="none">alien-core.pkg</pkg-ref>
</installer-gui-script>
